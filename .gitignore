# Build output: build/ (Windows), build-linux/ and build-asan/ (WSL / Linux)
build*/
*.o
*.d
*.exe
*.obj
*.pdb
*.ilk

# Python bytecode from bench/summarize_results.py
__pycache__/
*.pyc

# Per-machine Claude Code settings
.claude/settings.local.json

# Strategies installed with `make strategy STRATEGY=...`. Only the .gitkeep is
# tracked: a strategy of your own stays yours.
arena/strategies/user/*.hpp

# Standard-suite run directories (make compare). They belong to whoever ran
# them; the published evidence is results/.
runs/

# Market data brought in with /data add (docs/DATA.md) and markets calibrated from
# it. A tape made from data you paid for must never be committed.
/data/
/markets/
