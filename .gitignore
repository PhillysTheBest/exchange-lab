build*/
*.o
*.exe
*.obj
*.pdb
*.ilk

# Kalshi credentials — never committed
*.pem
*.key
.env

# Stage 5: regenerated on every `make perf-regression` run — perf/baseline/'s
# frozen snapshot is what's checked in, not this run's transient comparison.
perf/results/current_*.csv

# Stage 6: research/cross_market/ is a plain Python script, no venv/build checked in.
__pycache__/
*.pyc

# Stage 6: dashboard/ is a Rust (Cargo) crate — build artifacts, not source.
dashboard/target/
Cargo.lock

# Stage 6: telemetry snapshot file the C++ side writes and the dashboard reads —
# runtime output, not source (see telemetry/telemetry_publisher.hpp).
telemetry/snapshot.json
telemetry/snapshot.json.tmp
